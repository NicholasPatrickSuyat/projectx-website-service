{
  "name": "projectx-website-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate && npm run db:backfill-publication-html && node scripts/build-publication-css.mjs && next dev --port 3002",
    "dev:public": "npm run db:migrate && npm run db:backfill-publication-html && node scripts/sync-public-runtime-static.mjs && next dev ./public-runtime --port 3003",
    "build": "node scripts/build-publication-css.mjs && next build",
    "build:public": "node scripts/sync-public-runtime-static.mjs && next build ./public-runtime",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:cloudflare:public": "node scripts/build-cloudflare-public.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview --port 3002",
    "preview:cloudflare:public": "node scripts/preview-cloudflare-public.mjs",
    "test:public": "node scripts/smoke-public-runtime.mjs",
    "test:static-publication": "node --import ./scripts/publication-tsx-register.mjs scripts/smoke-static-publication.mjs && node --import ./scripts/publication-tsx-register.mjs scripts/smoke-publication-safety.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
    "admin:production": "node scripts/admin-production.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p public-runtime/tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply projectx-website-service --local",
    "db:backfill-publication-html": "node --import ./scripts/publication-tsx-register.mjs scripts/backfill-publication-html.mjs",
    "db:seed": "wrangler d1 execute projectx-website-service --local --file=scripts/seed-clients.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  }
}
