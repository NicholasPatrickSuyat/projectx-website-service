# Production-admin local secrets only. Copy to `.dev.vars.production-admin`.
# `.dev.vars.production-admin` is gitignored. Do not reuse local `.dev.vars`
# values. Do not commit real passwords, hashes, or session secrets.
#
# Generate a password hash with:
#   node scripts/hash-admin-password.mjs "<production-admin-password>"
# AUTH_SESSION_SECRET must be at least 32 characters of random data.

NEXTJS_ENV=development
PXWS_PRODUCTION_ADMIN=1

ADMIN_USERNAME=replace-with-production-admin-username
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$replace-salt$replace-hash
AUTH_SESSION_SECRET=replace-with-at-least-32-bytes-of-random-data
