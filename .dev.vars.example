# Local OpenNext / Wrangler development values only.
# Copy to `.dev.vars` if needed. Do not put secrets here.
# `.dev.vars` is gitignored.

NEXTJS_ENV=development

# Local admin authentication placeholders only.
# Generate a password hash with:
#   node scripts/hash-admin-password.mjs "<your-local-password>"
# AUTH_SESSION_SECRET must be at least 32 characters of random data.
# Never commit real passwords, hashes used as production credentials, or session secrets.

ADMIN_USERNAME=replace-with-local-admin-username
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$replace-salt$replace-hash
AUTH_SESSION_SECRET=replace-with-at-least-32-bytes-of-random-data

# Public runtime (`npm run dev:public`, `npm run build:cloudflare:public`)
# does NOT require the admin credentials above.
# Review media uses the HttpOnly review-token cookie / Referer, not HMAC.
# Do not add production secrets here.
