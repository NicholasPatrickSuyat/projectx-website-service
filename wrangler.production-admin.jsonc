{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production-admin / production D1 only. Do not use from npm run dev.
  // Do not deploy this Worker. Do not bind remote R2.
  "name": "projectx-website-service-production-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projectx-websites-production",
      "database_id": "db47d1af-bc9c-47f0-ad8a-1377971dbd24",
      "migrations_dir": "migrations",
      "remote": true
    }
  ]
}
