{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectx-website-service",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Do not publish a workers.dev hostname. This admin app has no auth yet.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "projectx-website-service"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // LOCAL / placeholder only. This is not a real production D1 database ID.
      // A future deployment milestone must create a real D1 database and
      // replace this value. Do not treat this UUID as a provisioned resource.
      "database_name": "projectx-website-service",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // LOCAL emulator identifier only. No remote R2 bucket has been created.
      // A future deployment milestone must create a real bucket and bind it.
      "bucket_name": "projectx-website-media-unprovisioned",
      "preview_bucket_name": "projectx-website-media-local",
      "remote": false
    }
  ]
}
