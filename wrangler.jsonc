{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectx-website-service",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Do not publish a workers.dev hostname. Production Client sites must use
  // a Workers route or Custom Domain after an approved deployment milestone.
  // Proposed future public Worker name: projectx-websites-public
  // (see docs/production-infrastructure.md). Do not create it from this file.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "projectx-website-service"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // LOCAL / placeholder only. This is not a real production D1 database ID.
      // A future deployment milestone must create a real D1 database and
      // replace this value. Do not treat this UUID as a provisioned resource.
      "database_name": "projectx-website-service",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA_KV",
      // LOCAL emulator identifier only. The production namespace
      // projectx-websites-media must not appear in this file.
      // Do not set remote: true in this file.
      "id": "00000000-0000-4000-8000-000000000003",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // DORMANT local emulator identifier only. V1 production media is
      // Workers KV, not R2. No remote R2 bucket has been created.
      "bucket_name": "projectx-website-media-unprovisioned",
      "preview_bucket_name": "projectx-website-media-local",
      "remote": false
    }
  ]
}
